{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URI for editor completion.",
      "type": "string"
    },
    "tabTitle": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable dynamic Zellij tab title updates.",
          "type": "boolean",
          "default": true
        },
        "emojiIdle": {
          "description": "Prefix used when OpenCode is idle.",
          "type": "string",
          "default": "🟢"
        },
        "emojiRunning": {
          "description": "Prefix used while OpenCode is running work.",
          "type": "string",
          "default": "⚡"
        },
        "emojiNeedsInput": {
          "description": "Prefix used when OpenCode is waiting for human input.",
          "type": "string",
          "default": "💬"
        },
        "emojiBranch": {
          "description": "Prefix used before the current git branch name.",
          "type": "string",
          "default": "🌱"
        },
        "debounceMs": {
          "description": "Debounce time for tab title updates in milliseconds.",
          "type": "number",
          "minimum": 0,
          "default": 300
        }
      },
      "additionalProperties": false
    },
    "pty": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable Zellij-backed PTY tools.",
          "type": "boolean",
          "default": true
        },
        "cleanupExitedPaneOnRead": {
          "description": "Remove exited PTY panes after they are read.",
          "type": "boolean",
          "default": true
        },
        "sudoPane": {
          "description": "Controls whether the sudo pane tool is available, denied, or hidden.",
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "hide"
          ],
          "default": "allow"
        },
        "completionNotification": {
          "description": "Completion notification delivery settings.",
          "type": "object",
          "properties": {
            "mode": {
              "description": "Controls how completion notifications are delivered.",
              "type": "string",
              "enum": [
                "off",
                "queue",
                "toast",
                "queue+toast",
                "prompt"
              ],
              "default": "queue+toast"
            },
            "prompt": {
              "description": "Prompt-specific completion notification settings.",
              "type": "object",
              "properties": {
                "requireIdle": {
                  "description": "Require the plugin to be idle before prompting.",
                  "type": "boolean",
                  "default": true
                },
                "cooldownMs": {
                  "description": "Cooldown time before prompting again in milliseconds.",
                  "type": "number",
                  "minimum": 0,
                  "default": 30000
                },
                "maxAttempts": {
                  "description": "Maximum prompt attempts before backing off.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "default": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoUpdate": {
      "description": "Enable automatic update checks for the opencode-zellij plugin.",
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/maou-shonen/opencode-zellij/main/opencode-zellij.schema.json",
  "title": "opencode-zellij config"
}
